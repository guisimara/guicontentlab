# Copie este arquivo para .env.local e preencha com as credenciais do seu
# OAuth Client (Google Cloud Console > APIs & Services > Credentials).
# .env.local nunca é commitado (está no .gitignore).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve bater EXATAMENTE com uma "Authorized redirect URI" cadastrada no
# OAuth Client. Em dev local normalmente http://localhost:3001/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Opcional. ID de uma pasta do Drive já existente para usar como pasta-raiz
# (em vez da pasta "CONTENT LAB | Gui Simara" criada automaticamente pelo
# app). Pegue o ID na URL da pasta: drive.google.com/drive/folders/<ID>.
# Atenção: com o escopo drive.file usado aqui, isso só funciona se a pasta
# tiver sido criada por este app — uma pasta criada manualmente pela UI do
# Drive fica invisível para esse escopo (precisaria de um escopo mais amplo,
# tipo drive, com novo consentimento). Deixe em branco para manter o padrão.
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
